      {
        "line": 15,
        "statement": "dist<-read.csv(file=\"GRID_trap_dist.csv\")"
      },
      {
        "line": 16,
        "statement": "#This above file is a file which gives you the distance (in meters) between each trapping location"
      },
      {
        "line": 17,
        "statement": "#and every other trap in a trapping grid where the distance between traps is 10m. Trap lines are labeled"
      },
      {
        "line": 18,
        "statement": "#\"A\" through \"J\" and locations along each line are numbered \"1\" through \"10\" (i.e., the fifth trap on"
      },
      {
        "line": 19,
        "statement": "# the first trapping line is trap \"A5\")"
      },
      {
        "line": 22,
        "statement": "### set the \"trap neighborhood\" to within 28.05 (the trap neighborhood is the same for peromyscus and myodes so can be"
      },
      {
        "line": 23,
        "statement": "### done together). The value 28.05 was calculated using the secr package and the dbar() command on the capture histories per trapping grid"
      },
      {
        "line": 24,
        "statement": "### to calculate average daily movements of the two target species. We found on average that the distance between consecutive captures"
      },
      {
        "line": 25,
        "statement": "### of these target species is up to 28.05 meters, so we will look within this distance from every target trap to find the \"neighborhood of"
      },
      {
        "line": 26,
        "statement": "### available traps\" on that trapping occasion"
      },
      {
        "line": 28,
        "statement": "dist<-subset(dist, DISTANCE<=28.05)"
      },
      {
        "line": 35,
        "statement": "micro<-read.csv(file=\"microhabitat.csv\")"
      },
      {
        "line": 46,
        "statement": "##get the factor scores and put them into a data frame associated with the trap site"
      },
      {
        "line": 59,
        "statement": "#put the microhabitat variable TC1 of site1 and site2 into the dataset, where site 1 is the target trap, and site 2"
      },
      {
        "line": 60,
        "statement": "#is every other trap site in the trapping grid of interest"
      },
      {
        "line": 64,
        "statement": "dist<-merge(dist, tc1, by=\"SITE1\", all.x = TRUE)"
      },
      {
        "line": 67,
        "statement": "dist<-merge(dist, tc1, by=\"SITE2\", all.x = TRUE)"
      },
      {
        "line": 72,
        "statement": "#now insert the \"16_19_GRID_occup.csv\" which contains the occupancy data for each trap and each occasion from all 4 trapping seasons"
      },
      {
        "line": 73,
        "statement": "occup<-read.csv(file=\"16_19_GRID_occup.csv\")"
      },
      {
        "line": 76,
        "statement": "#only occupied target trap sites"
      },
      {
        "line": 77,
        "statement": "occupsite<-subset(occup, OCCUP==1)"
      },
      {
        "line": 79,
        "statement": "#merge in the dataset with the microhabitat components at the other trap sites that are within our specified distance"
      },
      {
        "line": 80,
        "statement": "dist2<-merge(occupsite, dist, by=\"SITE1\", all.x = TRUE)"
      },
      {
        "line": 84,
        "statement": "#now select just unoccupied neighbor traps"
      },
      {
        "line": 85,
        "statement": "occupneighbor<-subset(occup, OCCUP==0)"
      },
      {
        "line": 87,
        "statement": "dist3<-merge(occup,dist2, by=c(\"SITE2\", \"UNIQUE_OCC\"), all.x = TRUE)"
      },
      {
        "line": 88,
        "statement": "sub<-subset(dist3, SITE1!=\"NA\")"
