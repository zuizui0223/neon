      {
        "line": 100,
        "statement": "#extract only traps within the neighborhood that were not already occupied on that occasion."
      },
      {
        "line": 101,
        "statement": "#this assumes, conservatively, that each trap is occupied after all surrounding traps have already become occupied"
      },
      {
