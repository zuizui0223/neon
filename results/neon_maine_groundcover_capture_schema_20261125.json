        "statement": "#calculate the mean component value in the neighborhood of available traps on every trapping occasion"
      },
      {
        "line": 117,
        "statement": "MEANTC1<-available %>% group_by(SITE1, UNIQUE_OCC) %>% summarise(MEANTC1 = mean(unique(SITE2_TC1), na.rm=TRUE))"
